# Python
__pycache__/
*.py[cod]
*.so
.Python
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Terraform
# Note: .terraform.lock.hcl is intentionally NOT ignored (HashiCorp guidance —
# commit it so provider versions stay reproducible across machines).
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
.terraformrc
terraform.rc

# Project secrets / certs (per _interfaces.md §2.4 — IoT x.509 certs)
simulator/.secrets/
**/.env
*.pem
*.key
*.crt

# User-local simulator config (per PO decision 2026-05-25 on Gemini add'l obs A —
# strict loader, no auto-defaults; users copy config.example.yaml -> config.yaml
# and tune locally; UX work deferred to a later onboarding session).
#
# Glob covers all per-developer copies — config.yaml (local Mosquitto smoke),
# config.aws-iot.yaml (added 2026-05-27 for the AWS IoT Phase D smoke), and any
# future config.<variant>.yaml — without needing another .gitignore edit each
# time. config.example.yaml is the only checked-in variant; the negation keeps
# it tracked.
simulator/config*.yaml
!simulator/config.example.yaml

# Local data (Docker volumes — InfluxDB, Mosquitto persistence when local_runtime lands)
data/
local_runtime/data/

# Per-developer scratch dir (mosquitto.conf for smoke tests, ad-hoc probe scripts).
# Convention: anything under .local/ is NEVER required for the project to work —
# it's host-specific glue (e.g. broker config mounts) for whoever is running it.
.local/

# Dev quality-of-life (per Gemini review of 2026-05-24-simulator-pump)
.envrc          # direnv
.python-version # pyenv

# Local backups (e.g. .docx editing fallbacks)
*.bak-*

# Gemini review debug dumps (from `gemini_review.ps1 -DumpBody`)
review_responses/*.request.json

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Lambda deploy staging (scripts/build_lambda.* output; archive_file input)
.build/

# Local reviewer-cascade API keys (gitignored; sourced by gemini_review.ps1)
scripts/review_keys.local.*

# --- Public-repo hygiene (PO decision 2026-06-14, repo wrap-up) ---

# Binary planning drafts — kept locally, not tracked in the public repo.
# The project is documented in README.md + docs/ (ADRs, runbooks, diagrams).
PLAN.md.docx
ACCOUNT_SETUP.md.docx
docs/project_structure_overview_2026-06-04.pdf

# Stray scratch file from an old test run.
simulator-warn-tests.tmp

# Terraform saved plan files (binary; regenerated by `terraform plan -out`).
tfplan
*.tfplan
