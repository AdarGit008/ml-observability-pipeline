      "title": "Fleet Health — Failure Probability",
      "description": "Latest P(failure_48h) per pump from DynamoDB STATE rows via adapter.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity-aws" },
      "targets": [
        {
          "type": "json",
          "refId": "A",
          "source": "url",
      "format": "table",
      "url": "${adapter_url}",
          "data": "",
          "root_selector": "pumps",
          "columns": [
            { "selector": "pump_id", "text": "pump_id", "type": "string" },
            { "selector": "latest_score", "text": "score", "type": "number" },
            { "selector": "latest_ts", "text": "time", "type": "timestamp" }
          ]
        }
      ],
      "transformations": [
        {
          "id": "convertType",
          "options": {
            "conversions": [
              { "targetField": "time", "type": "timestamp" }
            ]
          }
